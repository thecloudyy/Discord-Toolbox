{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Discord Toolbox",
  "mainBinaryName": "discord-toolbox",
  "version": "1.0.11",
  "identifier": "com.thecloudyy.discord-toolbox",
  "build": {
    "beforeDevCommand": "cd ui && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ui && trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "Discord Toolbox",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}